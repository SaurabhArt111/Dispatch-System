# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/dispatch_management

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
SCREEN_PAIRING_SECRET=change_this_screen_pairing_secret

# System 1 Integration (Delivery Challan source system)
SYSTEM1_API_URL=
SYSTEM1_API_KEY=
SYSTEM1_WEBHOOK_SECRET=change_this_webhook_secret
# When true, backend uses the built-in mock System 1 service instead of a real API
USE_MOCK_SYSTEM1=true
